<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LyWaf.PluginSdk</AssemblyName>
    <RootNamespace>LyWaf.Plugins.Core</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NLog" Version="6.0.5" />
    <Compile Include="..\..\Plugins\Core\ILyWafPlugin.cs" Link="ILyWafPlugin.cs" />
    <Compile Include="..\..\Plugins\Core\IPluginEventBus.cs" Link="IPluginEventBus.cs" />
    <Compile Include="..\..\Plugins\Core\PluginContracts.cs" Link="PluginContracts.cs" />
  </ItemGroup>
</Project>
