<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.0.5" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.0.5" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- IP地理位置库：用于国家/地区访问控制 -->
    <PackageReference Include="IP2Region.Net" Version="3.0.0" />
    <!-- ACME 客户端：用于 Let's Encrypt 证书自动申请 -->
    <PackageReference Include="Certes" Version="3.0.4" />
    <!-- 图片处理库：用于实时图片缩放、裁剪、格式转换 -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <!-- 嵌入式分析数据库：用于统计数据持久化 -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.4.4" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Remove="sdk\**\*.cs" />
    <Compile Remove="Plugins\Core\ILyWafPlugin.cs" />
    <Compile Remove="Plugins\Core\IPluginEventBus.cs" />
    <Compile Remove="Plugins\Core\PluginContracts.cs" />
     <None Update="nlog.config" CopyToOutputDirectory="Always" />
     <None Update="config.ly" CopyToOutputDirectory="Always" />
     <None Update="config.ly.example" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="sdk\LyWaf.PluginSdk\LyWaf.PluginSdk.csproj" />
  </ItemGroup>

  <!-- 确保 control_html 目录复制到输出 -->
  <ItemGroup>
    <Content Include="control_html\**" CopyToOutputDirectory="Always" Exclude="@(Content)" />
  </ItemGroup>

  <!-- 确保 templates 目录复制到输出 -->
  <ItemGroup>
    <Content Include="templates\**" CopyToOutputDirectory="Always" />
    <Content Include="Rules\**" CopyToOutputDirectory="Always" />
    <Content Include="datas\**" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- 排除运行时状态文件、用户配置、构建产物等 -->
  <ItemGroup>
    <Compile Remove="benchmarks\**\*.cs" />
    <Compile Remove="tests\LyWaf.Tests\**\*.cs" />
    <Content Remove=".lywaf.*" />
    <Content Remove="config.ly.*" />
    <!-- 排除 DuckDB 运行时数据库文件（由程序启动时自动创建） -->
    <Content Remove="datas\*.duckdb" />
    <Content Remove="datas\*.duckdb.*" />
    <None Remove=".lywaf.*" />
    <None Remove="artifacts\**;Frontend\**;benchmarks\**;tests\**;tools\**;certs\**;plugin_data\**" />
    <Content Remove="publish\**" />
    <Content Remove="artifacts\**" />
    <Content Remove="Frontend\**" />
    <Content Remove="benchmarks\**" />
    <Content Remove="tests\**" />
    <Content Remove="tools\**" />
    <Content Remove="certs\**" />
    <Content Remove="plugin_data\**" />
    <Content Remove="temp\**" />
    <Content Remove="logs\**" />
    <Content Remove="bin*\**" />
    <!-- 保留 config.ly.example -->
    <None Include="config.ly.example" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
