# boundary regression cases
# Set base_url to an authorized test WAF (no trailing slash).
# The upstream root must return 200 for before/after controls.
# Use --continue-on-error --path-as-is --jobs 1.

# edge-method-DELETE--raw | boundary | Original transport/boundary probe
GET {{base_url}}/
X-Hurl-Case: edge-method-DELETE--raw-before
HTTP 200

DELETE {{base_url}}/probe?q=%27%20or%201%3D1%20--
X-Hurl-Case: edge-method-DELETE--raw
HTTP 403

GET {{base_url}}/
X-Hurl-Case: edge-method-DELETE--raw-after
HTTP 200


