# ============================================================
# LyWaf 配置文件示例 (config.ly)
# 类似 Caddy 的简洁配置格式
# 格式参考: https://caddyserver.com/docs/caddyfile/concepts
# ============================================================

# 变量定义
var domain = "example.com"
var backend = "127.0.0.1:8080"
var env = "production"

# ============================================================
# 全局选项（可选，必须在最前面）
# ============================================================
{
    # ACME 邮箱（用于 Let's Encrypt）
    email admin@example.com
    
    # 使用 staging 环境测试
    if $env != "production" {
        acme_staging true
    }
    
    # 调试模式
    # debug
}

# ============================================================
# 代码片段（可重用配置）
# ============================================================
(common_headers) {
    HeaderUps {
        X-Real-IP = "{ClientIp}"
        X-Forwarded-For = "{ClientIp}"
    }
}

(rate_limit) {
    SpeedLimit {
        Limits {
            Fixed {
                PermitLimit = 100
                Window = "00:01:00"
            }
        }
    }
}

# ============================================================
# 站点配置（以域名或地址开头）
# ============================================================

# 证书配置（根目录下）
Certs {
    # 默认证书
    PemFile = "/path/to/default-cert.pem"
    KeyFile = "/path/to/default-key.pem"
    
    # 域名特定证书
    $domain {
        PemFile = "/path/to/${domain}-cert.pem"
        KeyFile = "/path/to/${domain}-key.pem"
    }
    
    api.${domain} {
        PemFile = "/path/to/api-cert.pem"
        KeyFile = "/path/to/api-key.pem"
    }
}

# 主站点 - 支持多路由配置
$domain www.${domain} {
    # 站点级别日志配置（自动归并到 LyLog 模块）
    log {
        output = "logs/${domain}"
        level = "Info"
        exclude_paths = ["/health", "/favicon.ico"]
    }
    
    # 不同路径转发到不同后端
    /api/* {
        reverse_proxy http://127.0.0.1:3000
        lb_policy RoundRobin
    }
    
    /file/* {
        reverse_proxy http://127.0.0.1:4000
    }
    
    # 静态文件服务
    /static/* {
        file_server {
            root = "./wwwroot/static"
            browse = true
            index = "index.html index.htm"
        }
    }
    
    # 默认路由（其他所有请求）
    reverse_proxy http://${backend}
}

# 纯文件服务站点
files.${domain} {
    # 简单的文件服务（使用当前目录）
    file_server
}

# 带配置的文件服务
static.${domain} {
    file_server {
        root = "./public"
        browse = true
        index = "index.html default.html"
        try_files = "index.html /404.html"
        precompressed = true
    }
}

# API 站点 - 使用 handle 块
api.${domain} {
    # 简化日志配置：只指定输出目录
    log = "logs/api"
    
    handle {
        /v1/* {
            reverse_proxy http://127.0.0.1:3001
        }
        /v2/* {
            reverse_proxy http://127.0.0.1:3002
        }
    }
    
    # 默认后端
    reverse_proxy http://127.0.0.1:3000
    lb_policy WeightedRoundRobin
}

# 管理后台 - HTTPS
https://admin.${domain} {
    reverse_proxy http://127.0.0.1:9000
}

# 端口监听（无域名限制）
:8080 {
    reverse_proxy http://127.0.0.1:8081
}

# HTTPS 端口监听
https://:443 {
    # 这将监听所有域名的 443 端口
    reverse_proxy http://127.0.0.1:8080
}

# 本地开发
localhost:3000 {
    reverse_proxy http://127.0.0.1:3000
}

# proxy 是 reverse_proxy 的简写
localhost:4000 {
    # 以下两种写法等价
    proxy http://127.0.0.1:4000
}

# proxy 也支持完整配置格式
localhost:5000 {
    proxy {
        to = "http://127.0.0.1:5001 http://127.0.0.1:5002"
        lb_policy = "RoundRobin"
        timeout = "00:00:30"
        max_connections = 100
    }
}

# 内部服务使用自定义 DNS 解析
internal.${domain} {
    # backend.internal 会被自定义 DNS 解析为配置的 IP
    proxy http://backend.internal:8080
}

# ============================================================
# 其他全局配置
# ============================================================

# AllowedHosts 配置（限制允许的 Host 头）
AllowedHosts = "*"

# 自定义 DNS 配置（将域名解析为指定 IP）
CustomDns {
    Enabled = true
    CacheTtlSeconds = 300
    
    # 简单格式：域名 = "IP列表（空格分隔）"
    "backend.internal" = "192.168.1.100 192.168.1.101 192.168.1.102"
    
    # 通配符匹配：*.internal.example.com 匹配所有子域名
    "*.internal.example.com" = "10.0.0.1 10.0.0.2"
    
    # 完整配置格式
    "api.internal" {
        Addresses = ["192.168.1.200", "192.168.1.201"]
        Policy = "RoundRobin"    # 或 Random
        TtlSeconds = 60
    }
}

# 正向代理服务配置（HTTP 代理、HTTPS 代理、SOCKS5 代理）
ProxyServer {
    Enabled = true
    
    # 代理认证（可选）
    # Username = "proxyuser"
    # Password = "proxypass"
    
    # 超时配置
    ConnectTimeout = 30     # 连接超时（秒）
    DataTimeout = 300       # 数据传输超时（秒）
    
    # 访问控制
    # AllowedHosts = ["*.example.com", "api.service.com"]  # 白名单
    # BlockedHosts = ["*.blocked.com"]                      # 黑名单
    
    # 端口配置
    Ports {
        # HTTP/HTTPS 代理端口
        8080 {
            EnableHttp = true       # 支持 HTTP 代理
            EnableHttps = true      # 支持 HTTPS 隧道 (CONNECT)
            EnableSocks5 = false    # 不支持 SOCKS5
            RequireAuth = false     # 不需要认证
        }
        
        # SOCKS5 代理端口
        1080 {
            EnableHttp = false
            EnableHttps = false
            EnableSocks5 = true     # 支持 SOCKS5
            RequireAuth = true      # 需要认证
        }
        
        # 混合代理端口（同时支持所有协议）
        # 3128 = "http,https,socks5"  # 简化格式
    }
}

# 访问控制
AccessControl {
    RejectStatusCode = 403
    RejectMessage = "Access Denied: {ClientIp}"
    
    Whitelist = ["127.0.0.1", "10.0.0.0/8"]
    
    IpControl {
        Enabled = true
        Blacklist = ["1.2.3.4"]
    }
}

# 响应压缩
Compress {
    Enabled = true
    EnableBrotli = true
    EnableGzip = true
    Level = "Fastest"
    MinSize = 10240
}

# ACME 配置（Let's Encrypt）
Acme {
    Enabled = true
    AcceptTermsOfService = true
    Domains = [$domain, "www.${domain}", "api.${domain}"]
    
    if $env == "production" {
        UseStaging = false
    } else {
        UseStaging = true
    }
}

StreamServer {
    Enabled = true
    ConnectTimeout = 30
    DataTimeout = 300
    
    # 简单格式 - 单个上游
    3306 = "192.168.1.100:3306"
    
    # 列表格式 - 多个上游
    6379 = ["redis1:6379", "redis2:6379"]
    
    # 详细格式
    5432 {
        Upstreams = ["pg1:5432", "pg2:5432"]
        Policy = "RoundRobin"  # 或 Random, First
        ConnectTimeout = 10
    }
    
    # 绑定特定 IP
    127.0.0.1:8080 {
        Upstreams = ["backend:80"]
    }
}

# ============================================================
# A/B 测试配置 - 有两种方式
# ============================================================

# 方式一：使用 ABTest 全局配置 + ABCookieTest 负载均衡策略
# 适合需要统一管理多个 A/B 测试的场景
ABTest {
    # 首页 A/B 测试
    homepage-test {
        Name = "首页改版测试"
        Enabled = true
        # 模式: Random(纯随机), CookieSticky(Cookie会话保持), IpHash(IP哈希), UserIdHash(用户ID哈希)
        Mode = "CookieSticky"
        CookieName = "ab_homepage"
        CookieExpireDays = 30
        
        # 流量分配权重（百分比）
        Variants {
            A = 70    # 70% 流量到变体 A
            B = 30    # 30% 流量到变体 B
        }
        
        # 变体对应的后端 Destination ID
        VariantTargets {
            A = "dest1"     # 对应 Cluster 中的 dest1
            B = "dest2"     # 对应 Cluster 中的 dest2
        }
        
        # 匹配路径（空表示匹配所有）
        MatchPaths = ["/", "/home/*"]
        # 排除路径
        ExcludePaths = ["/api/*", "/static/*"]
    }
    
    # 多变体测试示例
    checkout-flow {
        Name = "结账流程测试"
        Mode = "IpHash"
        Variants {
            control = 50      # 对照组
            variant1 = 25     # 变体1
            variant2 = 25     # 变体2
        }
        VariantTargets {
            control = "dest1"
            variant1 = "dest2"
            variant2 = "dest3"
        }
        MatchPaths = ["/checkout/*"]
    }
}

# 使用 ABCookieTest 策略的站点配置示例
# 需要配合上面的 ABTest 配置使用
abtest.${domain} {
    proxy {
        to = "http://127.0.0.1:8001 http://127.0.0.1:8002"
        lb_policy = "ABCookieTest"    # 使用 A/B 测试负载均衡策略
        abtest_id = "homepage-test"   # 关联上面定义的 A/B 测试 ID
    }
}

# 方式二：使用 ABTestWeighted 策略（简单场景）
# 直接在 upstream 配置权重，无需配置 ABTest 块
# 适合简单的流量分配场景
simple-ab.${domain} {
    proxy {
        # upstream 地址后面加 @权重，或使用 weight=权重
        to = "http://127.0.0.1:8001@70 http://127.0.0.1:8002@30"
        lb_policy = "ABTestWeighted"  # 使用权重负载均衡
        ab_cookie = "ab_simple"       # Cookie 名称（会话保持）
        ab_cookie_expire = 30         # Cookie 有效期（天）
    }
}

# 三变体测试示例
multivariant.${domain} {
    proxy {
        to = "http://v1.backend:8080@50 http://v2a.backend:8080@25 http://v2b.backend:8080@25"
        lb_policy = "ABTestWeighted"
        ab_cookie = "ab_checkout"
    }
}

# ============================================================
# 域名日志配置 - 按域名分别记录日志
# ============================================================
# 
# 使用方式：在请求开始时会注入一个域名专用的 Logger 到 HttpContext
# 后续中间件可以通过以下方式使用：
#   var logger = context.GetLyLogger();  // 获取域名 Logger
#   logger?.Info("message");                  // 记录日志
# 
# 或使用扩展方法：
#   context.LogDomainInfo("message");
#   context.LogDomainError(ex, "error message");
#
LyLog {
    Enabled = true
    
    # 全局日志配置（没有配置专属域名日志时使用）
    Global {
        Enabled = true
        AccessLog = "access_${shortdate}.log"   # 支持 NLog 变量
        ErrorLog = "error_${shortdate}.log"
        Directory = "logs"                       # 日志目录
        Level = "Info"                          # Trace, Debug, Info, Warn, Error, Fatal
        Format = "Text"                         # Text 或 Json
        PerfLog = false                         # 高性能日志（保持文件打开）
    }
    
    # 域名日志配置（直接使用域名作为 key，无需 Domains 层级）
    
    # 主站日志 - 单独记录到 logs/example.com/
    $domain {
        Enabled = true
        Output = "logs/${domain}"           # 日志输出目录
        Level = "Info"
        Format = "Text"                     # Text 格式
        AlsoLogToGlobal = true              # 同时记录到全局日志
        ExcludePaths = ["/health", "/favicon.ico"]  # 排除的路径
    }
    
    # API 日志 - 单独记录到 logs/api/（JSON 格式便于分析）
    "api.${domain}" {
        Output = "logs/api"
        Level = "Debug"
        Format = "Json"                     # Json 格式: {"msg": "...", "time": "..."}
        ExcludePaths = ["/health", "/metrics"]
    }
    
    # 通配符匹配 - *.internal.example.com
    "*.internal.${domain}" {
        Output = "logs/internal"
        Level = "Debug"
        AlsoLogToGlobal = false             # 不记录到全局日志
    }
}

# ============================================================
# 错误页面模板配置
# ============================================================
# 支持的模板变量:
#   {client_ip} / {ClientIp} / {ip}     - 客户端IP
#   {path} / {Path}                     - 请求路径
#   {method} / {Method}                 - 请求方法
#   {host} / {Host}                     - 请求Host
#   {time} / {Time}                     - 当前时间
#   {status_code} / {StatusCode}        - 状态码
#   {status_text} / {StatusText}        - 状态文本
#   {user_agent} / {UserAgent}          - User-Agent
#   {referer} / {Referer}               - Referer
#   {query} / {Query}                   - 查询字符串
#   {reason} / {Reason}                 - 错误原因（需要 ShowReason = true）
#   {show_reason_info}                  - 格式化的原因HTML
#
ErrorTemplate {
    Enabled = true
    ShowReason = false                      # 生产环境建议关闭，避免泄露敏感信息
    
    # 403 Forbidden - 使用文件模板
    Forbidden {
        Type = "File"
        FilePath = "templates/403.html"
        ContentType = "text/html; charset=utf-8"
    }
    
    # 404 Not Found - 使用内联模板
    NotFound {
        Type = "Inline"
        Content = """
            <!DOCTYPE html>
            <html>
            <head><title>404 Not Found</title></head>
            <body style="text-align:center;padding:50px;">
                <h1>404</h1>
                <p>页面不存在: {path}</p>
                <p><small>LyWaf</small></p>
            </body>
            </html>
        """
    }
    
    # 429 Too Many Requests - CC防护触发
    TooManyRequests {
        Type = "File"
        FilePath = "templates/429.html"
    }
    
    # 502 Bad Gateway
    BadGateway {
        Type = "Default"                    # 使用默认模板
    }
    
    # 503 Service Unavailable
    ServiceUnavailable {
        Type = "File"
        FilePath = "templates/503.html"
        Headers {
            Retry-After = "60"
        }
    }
    
    # 自定义状态码模板
    Custom {
        "418" {
            Type = "Inline"
            Content = "<h1>I'm a teapot ☕</h1>"
            ContentType = "text/html; charset=utf-8"
        }
    }
}

# ============================================================
# 条件配置
# ============================================================
if $env == "development" {
    # 开发环境使用 Debug 级别
    LyLog {
        Global {
            Level = "Debug"
        }
    }
}

if $env == "production" {
    # 生产环境使用 Info 级别
    LyLog {
        Global {
            Level = "Info"
            PerfLog = true                      # 生产环境启用高性能日志
        }
    }
}

# 导入其他配置文件
# import "sites/*.ly"
